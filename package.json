{
  "name": "@introspection-recipes/pi-codex",
  "version": "0.1.1",
  "description": "OpenAI Codex CLI harness reproduced as an Introspection (Pi) recipe — a pi-codex starter template.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@introspection-ai/recipes": "^0.14.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  },
  "pi": {
    "agents": [
      "./agents/*.yaml"
    ],
    "skills": [
      "./skills/**/SKILL.md"
    ],
    "prompts": [
      "./prompts/plan.md",
      "./prompts/review.md"
    ],
    "extensions": [
      "./extensions/*.ts",
      "./extensions/*/index.ts"
    ]
  }
}
